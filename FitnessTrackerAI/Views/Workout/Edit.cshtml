@model Workout

<h2>Редакция на тренировка</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Date" />
    <div>
        <label>Име на упражнение:</label><br />
        <input asp-for="ExerciseName" required />
    </div>
    <div>
        <label>Мускулна група (напр. Гърди, Крака):</label><br />
        <input asp-for="MuscleGroup" required />
    </div>
    <div>
        <label>Серии:</label><br />
        <input asp-for="Sets" type="number" required />
    </div>
    <div>
        <label>Повторения:</label><br />
        <input asp-for="Reps" type="number" required />
    </div>
    <div>
        <label>Тежест (кг):</label><br />
        <input asp-for="Weight" type="number" step="0.1" required />
    </div>
    <br />
    <button type="submit">Запиши промените</button>
</form>

<p><a asp-action="Index">Назад към списъка</a></p>
