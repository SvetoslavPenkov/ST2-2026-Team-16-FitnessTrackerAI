@model IEnumerable<Workout>

<h2>История на тренировките</h2>

<form method="get" asp-action="Index">
    <input type="text" name="muscleGroupFilter" placeholder="Филтър по мускулна група..." value="@ViewBag.CurrentFilter" />
    <button type="submit">Филтрирай</button>
    <a asp-action="Index">Изчисти</a>
</form>

<p>
    <a asp-action="Create">+ Добави нова тренировка</a> |
    <a asp-action="Advice">AI съвет</a>
</p>

<table border="1" cellpadding="5">
    <tr>
        <th>Упражнение</th>
        <th>Мускулна група</th>
        <th>Серии</th>
        <th>Повторения</th>
        <th>Тежест</th>
        <th>Дата</th>
        <th>Действия</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.ExerciseName</td>
            <td>@item.MuscleGroup</td>
            <td>@item.Sets</td>
            <td>@item.Reps</td>
            <td>@item.Weight</td>
            <td>@item.Date.ToString("dd.MM.yyyy")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Редактирай</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Изтрий</a>
            </td>
        </tr>
    }
</table>

<p style="color: green;">@ViewBag.Status</p>
